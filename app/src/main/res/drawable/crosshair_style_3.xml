<?xml version="1.0" encoding="utf-8"?>
<!-- Crosshair Style 3: Corner brackets -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top-left corner horizontal -->
    <item android:top="0dp" android:bottom="40dp" android:left="0dp" android:right="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:height="3dp" />
        </shape>
    </item>
    <!-- Top-left corner vertical -->
    <item android:top="0dp" android:bottom="40dp" android:left="0dp" android:right="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:width="3dp" />
        </shape>
    </item>
    <!-- Top-right corner horizontal -->
    <item android:top="0dp" android:bottom="40dp" android:left="40dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:height="3dp" />
        </shape>
    </item>
    <!-- Top-right corner vertical -->
    <item android:top="0dp" android:bottom="40dp" android:left="40dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:width="3dp" />
        </shape>
    </item>
    <!-- Bottom-left corner horizontal -->
    <item android:top="40dp" android:bottom="0dp" android:left="0dp" android:right="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:height="3dp" />
        </shape>
    </item>
    <!-- Bottom-right corner horizontal -->
    <item android:top="40dp" android:bottom="0dp" android:left="40dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:height="3dp" />
        </shape>
    </item>
    <!-- Center dot -->
    <item android:top="22dp" android:bottom="22dp" android:left="22dp" android:right="22dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</layer-list>
