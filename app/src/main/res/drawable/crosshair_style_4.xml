<?xml version="1.0" encoding="utf-8"?>
<!-- Crosshair Style 4: Cross with circle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle ring -->
    <item android:top="12dp" android:bottom="12dp" android:left="12dp" android:right="12dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@android:color/white" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Vertical bar top -->
    <item android:left="23dp" android:right="23dp" android:bottom="32dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <!-- Vertical bar bottom -->
    <item android:left="23dp" android:right="23dp" android:top="32dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <!-- Horizontal bar left -->
    <item android:top="23dp" android:bottom="23dp" android:right="32dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <!-- Horizontal bar right -->
    <item android:top="23dp" android:bottom="23dp" android:left="32dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</layer-list>
